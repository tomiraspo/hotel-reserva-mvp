    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst libres = data.disponibles || [];\n\nif (libres.length === 0) {\n  return [{ json: { mensaje: `No hay habitaciones libres del ${data.checkin} al ${data.checkout}.` } }];\n}\n\nconst detalle = libres\n  .map(h => `- ${h.nombre}: $${h.total_estimado} (${data.noches} noches)`)\n  .join(\"\\n\");\n\nconst mensaje = `Disponibilidad del ${data.checkin} al ${data.checkout}:\\n${detalle}`;\n\nreturn [{ json: { mensaje } }];"
      },
